# Shared Isaac image for the Ray worker and the HPC .sif: Ubuntu 24.04 + the Isaac Lab 3 source clone, installed into
# a uv venv from Isaac Lab's own lock (torch 2.11, Kit as the isaacsim 6.1 wheel), with the workspace packages
# mounted at job start (entrypoint.sh). Build: `pls docker build`.

ARG BASE_IMAGE=ubuntu:24.04
FROM ghcr.io/astral-sh/uv:0.11.7 AS uv
FROM ${BASE_IMAGE} AS base

# Isaac Lab ref and uv extras: docker_interface.sh passes workspace.defaults.yaml's, plus isaacsim (Kit).
ARG ISAACLAB_REPO=https://github.com/isaac-sim/IsaacLab.git
ARG ISAACLAB_REF=v3.0.0-EA
ARG ISAACLAB_EXTRAS="isaacsim rsl-rl ovphysx importers video"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root
ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
ENV ISAACLAB_PATH=/opt/IsaacLab
ENV VIRTUAL_ENV=/opt/isaaclab-venv
ENV PATH="/opt/isaaclab-venv/bin:/usr/local/nvidia/bin:${PATH}"
# uv's managed CPython (Isaac Lab sets python-preference = "only-managed") lives in the image, outside any cache.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
ENV UV_PROJECT_ENVIRONMENT=/opt/isaaclab-venv
ENV UV_LINK_MODE=copy
ENV UV_HTTP_RETRIES=12
# Accept the Isaac Sim EULA non-interactively (headless cluster/Ray runs).
ENV OMNI_KIT_ACCEPT_EULA=YES
ENV ACCEPT_EULA=Y
# The NVIDIA runtime mounts the driver's graphics (Vulkan/EGL) libraries as well as CUDA.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV LD_LIBRARY_PATH="/usr/local/nvidia/lib64"

# System deps: build toolchain, Ray-liveness wget, ssh+rsync for code sync, git(-lfs) for asset pulls, and the
# libraries Kit and ovrtx load (Vulkan loader, GLVND GL/EGL/OpenGL, GLU, X11 client libs, libgomp).
RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git wget curl ca-certificates openssh-client rsync graphviz libglib2.0-0 ncurses-term \
    libgomp1 libvulkan1 libgl1 libglu1-mesa libegl1 libopengl0 libglx0 libx11-6 libxext6 libxrender1 libxrandr2 \
    libxi6 libxt6 libxinerama1 libxcursor1 libxkbcommon0 libsm6 libice6 && \
    apt -y autoremove && apt clean autoclean && rm -rf /var/lib/apt/lists/*

# arm64 only: imgui-bundle has no aarch64 wheel and builds against the GL/X11 headers.
RUN --mount=type=cache,target=/var/cache/apt \
    if [ "$(dpkg --print-architecture)" = arm64 ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-dev libopengl-dev libglx-dev libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY --from=uv /uv /uvx /usr/local/bin/

# Isaac Lab 3 has no pip release: the pinned source clone, whose packages the venv installs editable.
RUN git init -q ${ISAACLAB_PATH} && \
    git -C ${ISAACLAB_PATH} fetch -q --depth 1 ${ISAACLAB_REPO} ${ISAACLAB_REF} && \
    git -C ${ISAACLAB_PATH} checkout -q FETCH_HEAD && \
    git -C ${ISAACLAB_PATH} log -1 --format="[isaaclab] ${ISAACLAB_REF} = %H"

# The venv from Isaac Lab's lock: --frozen installs exactly uv.lock (torch 2.11.0 cu128 on x86_64, cu130 on aarch64;
# the isaacsim 6.1.0.0 Kit wheels), never a re-resolve. The lock's pydantic 2.14.0a1 rejects wandb's artifact-file
# responses, so 2.11.10 replaces it.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync -q --project ${ISAACLAB_PATH} --frozen $(for e in ${ISAACLAB_EXTRAS}; do printf -- "--extra %s " "$e"; done) && \
    uv pip install -q --python ${VIRTUAL_ENV}/bin/python "pydantic==2.11.10"

# Ray and tooling, then the runtime deps of the PYTHONPATH'd workspace packages (generated by
# collect_workspace_deps.py), under the cross-cutting pins and every version the lock installed.
COPY requirements.workspace.txt constraints.workspace.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv \
    backend=cu128; [ "$(uname -m)" = aarch64 ] && backend=cu130; \
    uv pip freeze --python ${VIRTUAL_ENV}/bin/python --exclude-editable > /tmp/installed.txt && \
    uv pip install -q --python ${VIRTUAL_ENV}/bin/python --torch-backend ${backend} \
        --index-strategy unsafe-best-match --prerelease allow -c /tmp/installed.txt -c /tmp/constraints.workspace.txt \
        "ray[default,tune]==2.50.1" optuna bayesian-optimization gitman -r /tmp/requirements.workspace.txt

# git-lfs (robot assets / motion datasets / policies are pulled via LFS during code sync).
COPY install-git-lfs.sh /tmp/install-git-lfs.sh
RUN bash /tmp/install-git-lfs.sh && git lfs version

# `ray` and `python` resolve to the venv (Ray liveness probe + CLI on the cluster); /isaac-sim/python.sh is the
# interpreter path the Ray job configs, run_singularity.sh and res name.
RUN ln -sf ${VIRTUAL_ENV}/bin/ray /usr/local/bin/ray && \
    mkdir -p /isaac-sim && \
    printf '#!/bin/bash\nexec %s/bin/python "$@"\n' "${VIRTUAL_ENV}" > /isaac-sim/python.sh && \
    chmod +x /isaac-sim/python.sh

# NVIDIA runtime paths.
RUN ln -sf /usr/local/nvidia/bin/nvidia* /usr/bin 2>/dev/null || true

# Apptainer bind-point placeholders and cache dirs, so the image converts to a .sif.
RUN mkdir -p /isaac-sim/kit/cache /root/.cache/ov /root/.cache/pip \
    /root/.cache/nvidia/GLCache /root/.nv/ComputeCache /root/.nvidia-omniverse/logs \
    /root/.local/share/ov/data /root/Documents /tmp /workspace/ext && \
    touch /bin/nvidia-smi /bin/nvidia-debugdump /bin/nvidia-persistenced \
    /bin/nvidia-cuda-mps-control /bin/nvidia-cuda-mps-server /etc/localtime && \
    mkdir -p /var/run/nvidia-persistenced && touch /var/run/nvidia-persistenced/socket

# The entrypoint PYTHONPATHs the mounted workspace packages ahead of the baked Isaac Lab, and preloads libgomp on aarch64.
COPY entrypoint.sh /usr/local/bin/hcrl-entrypoint
RUN chmod +x /usr/local/bin/hcrl-entrypoint

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/hcrl-entrypoint"]
